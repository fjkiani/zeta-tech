# Hygraph Content API (public read - create token in Hygraph)
# Classic: https://api-us-west-2.hygraph.com/v2/<projectId>/master
# CDN HPCA: https://us-west-2.cdn.hygraph.com/content/<projectId>/master
# NOT graphassets.com (that is the Asset CDN for mp4/pdf files).
NEXT_PUBLIC_HYGRAPH_URL=https://us-west-2.cdn.hygraph.com/content/<projectId>/master
NEXT_PUBLIC_HYGRAPH_TOKEN=your_content_api_token

# Clerk (create app at dashboard.clerk.com - use SAME keys for portal, sandbox-app, AND bridge)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Bridge console URL (NotebookLM social bridge — not langchain-social-agent UI)
NEXT_PUBLIC_BRIDGE_URL=http://localhost:4317
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Sandbox app URL (when running: http://localhost:3001)
NEXT_PUBLIC_SANDBOX_URL=http://localhost:3001