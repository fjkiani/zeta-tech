    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "TypeError (String + Number)"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "Occurs when attempting to concatenate a string and a number directly. Fix: Convert the number with `str(number)`."
