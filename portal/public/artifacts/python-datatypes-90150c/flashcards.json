        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "Division Error (String / Integer)"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "Occurs when attempting to divide a string by an integer. Fix: Convert the string with `int(string)`."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "Quote Mismatch (SyntaxError)"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "Occurs when opening and closing quotes do not match (e.g., `name = 'Alice\"`). Fix: Match quotes consistently."
          }
        ]
      }
