# Bridge process env (copy to .env — never commit secrets)

PORT=4317
LANGGRAPH_API_URL=http://localhost:54367
LINKEDIN_USER_ID=
POST_TO_LINKEDIN_ORGANIZATION=true
LINKEDIN_ORGANIZATION_ID=107412290
LIVE=0

# Auth — either or both. Mutating POSTs require a configured gate.
BRIDGE_API_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: comma-separated authorized parties (azp) for Clerk JWTs
CLERK_AUTHORIZED_PARTIES=http://localhost:4317

# GTM LLM (optional). Stub path always works without these.
# LLM_PROVIDER=openrouter|openai_compatible|stub
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Switch models without code changes:
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
# Or any OpenAI-compatible base:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=
LLM_APP_NAME=zeta-notebooklm-social-bridge

# Hygraph Content API (NOT graphassets CDN — that hosts mp4 files only)
# Content API forms (both work for this project):
#   https://us-west-2.cdn.hygraph.com/content/<projectId>/master
#   https://api-us-west-2.hygraph.com/v2/<projectId>/master
# Token optional for public PUBLISHED-stage reads.
HYGRAPH_URL=https://us-west-2.cdn.hygraph.com/content/<projectId>/master
# HYGRAPH_TOKEN=
# NEXT_PUBLIC_HYGRAPH_URL=   # alias accepted by lib/hygraph.js
# NEXT_PUBLIC_HYGRAPH_TOKEN=
